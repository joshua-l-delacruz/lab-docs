{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lab-docs",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-21",
  "routes": [
    {
      "pattern": "joshuadelacruz.solutions",
      "custom_domain": true
    },
    {
      "pattern": "www.joshuadelacruz.solutions",
      "custom_domain": true
    },
    {
      "pattern": "calculator.joshuadelacruz.solutions",
      "custom_domain": true
    },
    {
      "pattern": "malware.joshuadelacruz.solutions",
      "custom_domain": true
    },
    {
      "pattern": "spending.joshuadelacruz.solutions",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "realestate-saas",
      "database_id": "deda6942-abd6-4a93-9167-22a417060953",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
